{
    "pyr4t": {
        "__desc__": "Pyr4t CLI",
        "__seq__":["[(-h | --help) | (-V | --version)]"],
        "install": {
            "__desc__": "Install a pyr4t package from R4tL's github repo (use '--info(-private)' to show all available package)",
            "__seq__": ["[<package> [(-V | --version) <version>]]", "[--info]", "[--info-private]", "[--token <token>]"]
        },
        "init": {
            "__desc__": "Generate a new python project architecture, default switched as active project",
            "__seq__": [
                "(--app | --cli | --lib)", "<title>", "[(-a | --authors) <alias1> <alias2> ...]",
                "[(-p | --path) <path>]", "[(-V | --version) <version>]"
            ]
        },
        "build": {
            "__desc__": "Build binary files in ./dist (.tar.gz, .whl)",
            "__seq__":["[--prj <title>]"]
        },
        "deploy": {
            "__desc__": "Deploy project using pip (--dev for editable mode)",
            "__seq__":["[--prj <title>]", "[--dev]"]
        },
        "run": {
            "__desc__": "Run a script file from ./scripts (default main.py)",
            "__seq__": ["[--prj <title>]", "[--dev]", "[<script>]"]
        },
        "test": {
            "__desc__": "Run tests in /tests (default all)",
            "__seq__": ["[--prj <title>]", "[<specific>]"]
        },
        "cls": {
            "__desc__": "Clean cache, logs and tmp files",
            "__seq__": ["[--prj <title>]", "[--cache]", "[--log]", "[--tmp]"]
        },
        "dstr": {
            "__desc__": "Check doctring and create/update template if necessary",
            "__seq__": ["[--prj <title>]"]
        },
        "fmt": {
            "__desc__": "Format scripts in ./src using black and isort",
            "__seq__": ["[--prj <title>]"]
        },
        "venv": {
            "__desc__": "Generate a python venv in ./.venv",
            "__seq__": ["[--prj <title>]"]
        },
        "dev": {
            "__desc__": "Generate dev env in ./dev",
            "__seq__": ["[--prj <title>]"] 
        },
        "info": {
            "__desc__": "Print current project informations"
        },
        "whoami": {
            "__desc__": "Print current user informations"
        },
        "prj": {
            "__desc__": "Manage project DB",
            "add": {
                "__desc__": "Add a local project to the pyr4t project DB",
                "__seq__": ["<title>", "<path>", "<version>"]
            },
            "ls": {
                "__desc__": "List projects from the pyr4t project DB"
            },
            "mv": {
                "__desc__": "Modify project information in the pyr4t project DB",
                "__seq__": ["<title>", "[(-p | --path) <path>]", "[(-V | --version) <version>]"]
            },
            "rm": {
                "__desc__": "Remove a project from the pyr4t project DB",
                "__seq__": ["<title>"]
            },
            "switch": {
                "__desc__": "Switch to another active project from the pyr4t project DB",
                "__seq__": ["<title>"]
            }
        },
        "usr": {
            "__desc__": "Manage user DB",
            "add": {
                "__desc__": "Add a user to the pyr4t user DB",
                "__seq__": ["<alias>", "<name>", "<email>"]
            },
            "ls": {
                "__desc__": "List users from the pyr4t user DB"
            },
            "mv": {
                "__desc__": "Modify user information in the pyr4t user DB",
                "__seq__": ["<alias>", "[(-e | --email) <email>]", "[(-n | --name) <name>]"]
            },
            "rm": {
                "__desc__": "Remove a user from the pyr4t user DB",
                "__seq__": ["<alias>"]
            },
            "switch": {
                "__desc__": "Switch to another default user from the pyr4t user DB",
                "__seq__": ["<alias>"]
            }
        }
    }
}